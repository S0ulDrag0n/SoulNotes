# LLM Provider Selection
# Options: "ollama" (default) or "openai-compatible"
# "openai-compatible" supports llama.cpp, LM Studio, vLLM, text-generation-webui, etc.
LLM_PROVIDER=ollama

# Ollama Configuration
# Default: localhost (override in .env.local for production server)
OLLAMA_BASE_URL=http://127.0.0.1:10102

# API Token for authenticated Ollama instances (optional)
# Use this if your Ollama server requires Bearer authentication
# The token will be sent as: Authorization: Bearer <token>
# For desktop mode, use the Settings UI instead - the token is stored
# securely in OS credential storage (Keychain on macOS, Credential Manager on Windows)
OLLAMA_API_TOKEN=your_api_token_here

OLLAMA_TRANSLATE_MODEL=aya-expanse:latest
OLLAMA_SUMMARIZE_MODEL=phi4:latest
OLLAMA_CONVERSATION_MODEL=aya-expanse:latest

# OpenAI-Compatible Configuration
# Used when LLM_PROVIDER=openai-compatible
# Compatible with llama.cpp, LM Studio, vLLM, text-generation-webui, and any
# server implementing the OpenAI /v1/chat/completions API
# Default: localhost (override in .env.local for production server)
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8080
# API token for authenticated endpoints (optional)
# For desktop mode, use the Settings UI instead - the token is stored
# securely in OS credential storage (Keychain on macOS, Credential Manager on Windows)
OPENAI_COMPATIBLE_API_TOKEN=your_api_token_here
OPENAI_COMPATIBLE_TRANSLATE_MODEL=
OPENAI_COMPATIBLE_SUMMARIZE_MODEL=
OPENAI_COMPATIBLE_CONVERSATION_MODEL=

# Speeches (Transcription) Configuration - Server-side
# Default: localhost (override in .env.local for production server)
SPEACHES_BASE_URL=http://127.0.0.1:10300
SPEACHES_TRANSCRIBE_MODEL=Systran/faster-whisper-large-v3
SPEACHES_TRANSCRIBE_LANGUAGE=zh

# Speeches Configuration - Client-side (NEXT_PUBLIC_ prefix required)
# These are used by the browser for realtime transcription and TTS
# Default: localhost (override in .env.local for production server)
NEXT_PUBLIC_SPEACHES_BASE_URL=http://127.0.0.1:10300
NEXT_PUBLIC_SPEACHES_TRANSCRIBE_MODEL=Systran/faster-whisper-large-v3
NEXT_PUBLIC_SPEACHES_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX